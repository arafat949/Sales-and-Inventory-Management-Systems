# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set DB_ENGINE=postgres to use PostgreSQL. Leave unset/sqlite for quick local demos.
DB_ENGINE=sqlite
DB_NAME=bsims_db
DB_USER=bsims_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

CURRENCY_SYMBOL=৳
BUSINESS_NAME=BSIMS Business
